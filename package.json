{
  "name": "spec-design-mcp",
  "version": "0.0.1",
  "type": "module",
  "bin": {
    "spec-design-mcp": "./dist/src/server.js",
    "spec-design-mcp-http": "./dist/src/http-server.js"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node scripts/dev-http.mjs",
    "start": "node dist/src/server.js",
    "start:http": "node dist/src/http-server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0",
    "zod": "^4.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  }
}
