# Spec Design MCP configuration sample.
# The app reads process environment variables directly; export values or use an env loader before running.

# Runtime storage. Leave empty to use the repository-local .runtime directory.
SPEC_DESIGN_MCP_RUNTIME_DIR=

# MVP default strategy:
# - rule_based is deterministic and works without network access.
# - openai_compatible is recommended for realistic MVP user intent extraction.
SPEC_DESIGN_MCP_INTENT_PROVIDER=rule_based
SPEC_DESIGN_MCP_LLM_ENDPOINT=
SPEC_DESIGN_MCP_LLM_MODEL=
SPEC_DESIGN_MCP_LLM_API_KEY=

# URL signal enrichment. Defaults keep MVP runs deterministic and avoid remote fetch risk.
SPEC_DESIGN_MCP_URL_FETCH=off
SPEC_DESIGN_MCP_URL_FETCH_TIMEOUT_MS=2000
SPEC_DESIGN_MCP_URL_FETCH_MAX_BYTES=64000
SPEC_DESIGN_MCP_URL_PARSER=local
SPEC_DESIGN_MCP_URL_PARSER_ENDPOINT=
SPEC_DESIGN_MCP_URL_PARSER_API_KEY=
SPEC_DESIGN_MCP_URL_PARSER_TIMEOUT_MS=2000

# Streamable HTTP transport.
SPEC_DESIGN_MCP_HTTP_HOST=127.0.0.1
SPEC_DESIGN_MCP_HTTP_PORT=3010
SPEC_DESIGN_MCP_HTTP_PATH=/mcp

# Set this before exposing HTTP beyond localhost. Clients send: Authorization: Bearer <token>.
SPEC_DESIGN_MCP_HTTP_AUTH_TOKEN=

# Comma-separated browser origins. Empty means no CORS headers are emitted.
SPEC_DESIGN_MCP_HTTP_ALLOWED_ORIGINS=

# Per-remote-address MCP request limit. Set either value to 0 to disable.
SPEC_DESIGN_MCP_HTTP_RATE_LIMIT_WINDOW_MS=60000
SPEC_DESIGN_MCP_HTTP_RATE_LIMIT_MAX_REQUESTS=120

# Example HTTP client script target. Optional; used by examples/mvp-http-client.mjs.
SPEC_DESIGN_MCP_MVP_URL=http://127.0.0.1:3010/mcp
